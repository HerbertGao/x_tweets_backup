# X Tweets Backup 配置文件
# 复制此文件为 .env 并根据需要修改配置

# ========================================
# 用户认证信息 (通过setup命令自动生成)
# ========================================
# 这些信息会从data/private_tokens.env自动加载
# 无需在此文件中设置

# ========================================
# 下载配置
# ========================================
# 每次获取的推文数量
COUNT=20

# 是否下载所有推文 (true/false)
ALL=true

# 下载目录
DOWNLOAD_DIR=data/downloads

# ========================================
# 目标用户配置
# ========================================
# 要备份的用户名（必需）
# 支持格式：username 或 @username
TARGET_USER_ID=

# 是否仅保留本人推文（过滤掉转推的他人内容）(true/false)
ONLY_SELF=false

# ========================================
# Markdown输出配置
# ========================================
# 是否保存推文内容为Markdown (true/false)
SAVE_MARKDOWN=true

# Markdown输出文件路径
MARKDOWN_OUTPUT=data/tweets_backup.md

# ========================================
# 调试配置
# ========================================
# 是否启用详细调试日志 (true/false)
# ⚠️ 警告: 启用后会输出敏感信息（包括认证令牌和用户数据）
# 默认值: false（安全默认值）
# 仅在调试时启用，生产环境请保持为 false
DEBUG_LOGS=false
